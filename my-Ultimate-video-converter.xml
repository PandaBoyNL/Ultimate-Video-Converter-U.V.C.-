<?xml version="1.0"?>
<Container version="2">
  <Name>ultimate-video-converter</Name>
  <Repository>ultimate-video-converter</Repository>
  <Registry>https://hub.docker.com/</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <MyMAC/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project/>
  <ReadMe/>
  <Overview>Ultimate Video Converter voor Unraid met web GUI, mappenstructuur selectie, FFmpeg ondersteuning, automatisch talenbeheer en Discord notificaties.</Overview>
  <Category>MediaApp:Video</Category>
  <WebUI>http://[IP]:[PORT:8383]/</WebUI>
  <TemplateURL/>
  <Icon>https://cdn-icons-png.flaticon.com/512/4204/4204104.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>1789320314</DateInstalled>
  <DonateText>Buy Me a Coffee (PayPal)</DonateText>
  <DonateLink>https://www.paypal.com/paypalme/PandaBoyNL</DonateLink>
  <Requires/>
  <Config Name="Web Port" Target="8080" Default="8383" Mode="tcp" Description="Container Port: 8080" Type="Port" Display="always" Required="true" Mask="{8}">8383</Config>
  <Config Name="Media Map" Target="/media" Default="/mnt/user/media/" Mode="rw" Description="Jouw hoofd-mediamap die uitgelezen moet worden" Type="Path" Display="always" Required="true" Mask="{8}">/mnt/user/media/</Config>
  <Config Name="Cache Map" Target="/cache" Default="/mnt/user/appdata/ultimate-converter/cache/" Mode="rw" Description="Automatische tijdelijke SSD-cache map" Type="Path" Display="always" Required="true" Mask="{8}">/mnt/user/appdata/ultimate-converter/cache/</Config>
  <Config Name="Discord Webhook" Target="DISCORD_WEBHOOK" Default="" Mode="" Description="Plak hier je Discord Webhook URL voor automatische meldingen" Type="Variable" Display="always" Required="false" Mask="{8}"></Config>
  <TailscaleStateDir/>
</Container>
