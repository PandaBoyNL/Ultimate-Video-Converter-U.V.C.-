<?xml version="1.0"?>
<Container version="2">
  <Name>ultimate-video-converter</Name>
  <Repository>pandaboynl/ultimate-video-converter</Repository>
  <Registry>https://hub.docker.com/</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/PandaBoyNL/Ultimate-Video-Converter-U.V.C.-/issues</Support>
  <Project>https://github.com/PandaBoyNL/Ultimate-Video-Converter-U.V.C.-</Project>
  <Overview>Ultimate Video Converter voor Unraid met web GUI, mappenstructuur selectie, FFmpeg ondersteuning, automatisch talenbeheer en Discord notificaties.</Overview>
  <Category>MediaApp:Video</Category>
  <WebUI>http://[IP]:[PORT:8383]/</WebUI>
  <Icon>https://raw.githubusercontent.com/PandaBoyNL/Ultimate-Video-Converter-U.V.C.-/main/logo.png</Icon>
  <ExtraParams/>
  <DateInstalled/>
  <DonateText>Buy Me a Coffee (PayPal)</DonateText>
  <DonateLink>https://www.paypal.com/paypalme/PandaBoyNL</DonateLink>
  <Description>Ultimate Video Converter voor Unraid</Description>
  <Config Name="Web Port" Target="8080" Default="8383" Mode="tcp" Description="Container Port: 8080" Type="Port" Display="always" Required="true" Perm="rw">8383</Config>
  <Config Name="Media Map" Target="/media" Default="/mnt/user/media/" Mode="rw" Description="Jouw hoofd-mediamap die uitgelezen moet worden" Type="Path" Display="always" Required="true" Perm="rw">/mnt/user/media/</Config>
  <Config Name="Cache Map" Target="/cache" Default="/mnt/user/appdata/ultimate-converter/cache/" Mode="rw" Description="Automatische tijdelijke SSD-cache map" Type="Path" Display="always" Required="true" Perm="rw">/mnt/user/appdata/ultimate-converter/cache/</Config>
  <Config Name="Discord Webhook" Target="DISCORD_WEBHOOK" Default="" Mode="" Description="Plak hier je Discord Webhook URL voor automatische meldingen" Type="Variable" Display="always" Required="false" Perm=""></Config>
</Container>
